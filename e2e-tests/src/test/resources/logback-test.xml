<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Reduce noise from WebDriverManager and RestAssured internals -->
    <logger name="io.github.bonigarcia" level="WARN"/>
    <logger name="io.restassured" level="WARN"/>
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <!-- Our test code — INFO level -->
    <logger name="com.voisetu.e2e" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
