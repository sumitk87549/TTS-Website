<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Words2Voice E2E Suite" verbose="2" parallel="false">

    <parameter name="base.url" value="http://localhost:4200"/>
    <parameter name="api.base.url" value="http://localhost:8080"/>
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <!-- ===== Register & Login UI Tests ===== -->
    <test name="Auth UI Tests — Register and Login">
        <classes>
            <class name="com.voisetu.e2e.runner.AuthUITestRunner"/>
        </classes>
    </test>

    <!-- ===== Auth REST API Tests ===== -->
    <test name="Auth API Tests — Register and Login Endpoints">
        <classes>
            <class name="com.voisetu.e2e.runner.AuthApiTestRunner"/>
        </classes>
    </test>

</suite>
